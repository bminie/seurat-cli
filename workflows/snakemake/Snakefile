# =============================================================================
# Seurat CLI Snakemake Pipeline
# =============================================================================
#
# Flexible pipeline for running Seurat CLI scripts in sequence.
#
# Usage:
#   snakemake --configfile config.yaml --cores 4
#   snakemake --configfile config.yaml --cores 4 -n  # Dry run
#   snakemake --configfile config.yaml --cores 4 --until differential_expression
#
# With Apptainer/Singularity container (Snakemake >= 8):
#   snakemake --configfile config.yaml --cores 4 --sdm apptainer
#
# On a SLURM cluster (needs snakemake-executor-plugin-slurm):
#   snakemake --configfile config.yaml --workflow-profile profiles/slurm
#
# On AWS Batch, Google Batch, or Azure Batch (see environment-cloud.yml):
#   snakemake --configfile my_config.yaml --workflow-profile profiles/aws-batch \
#       --default-storage-prefix s3://my-bucket/seurat-run
#
# Each step writes everything into its own output folder (e.g.
# results/01_basic/), and that folder is the step's output, so every figure
# and table is kept when outputs live in cloud storage.
#
# =============================================================================

import os
from pathlib import Path

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------

# Set defaults
configfile: "config.yaml"

# Container image for all rules (used with --sdm apptainer). A local .sif file
# also works, for compute nodes without internet access. The cloud executors
# use --container-image instead (set in their profiles).
container: config.get("container") or "docker://ghcr.io/bminie/seurat-cli:latest"

def using_container():
    """True when rules run in the container (--sdm apptainer)."""
    methods = getattr(getattr(workflow, "deployment_settings", None),
                      "deployment_method", None) or []
    return any(getattr(m, "name", str(m)).upper() == "APPTAINER" for m in methods)

# Each step's output is a folder. With cloud executors, Snakemake checks
# that the folder is in storage once a job finishes, and two storage plugins
# miss folders that a cloud job uploaded: snakemake-storage-plugin-s3 (0.3.6)
# remembers "not a folder" from its check before the job ran, and
# snakemake-storage-plugin-azure (0.4.4) only looks for a single file. Check
# the bucket again instead. Does nothing when the plugins aren't installed.
def _recheck_storage_folders():
    try:
        import snakemake_storage_plugin_s3 as s3_plugin
        s3_is_dir = s3_plugin.StorageObject.is_dir

        def is_dir(self):
            if not getattr(self, "_is_dir", None):
                self._is_dir = None
            return s3_is_dir(self)

        s3_plugin.StorageObject.is_dir = is_dir
    except (ImportError, AttributeError):
        pass
    try:
        import snakemake_storage_plugin_azure as az_plugin
        az_exists = az_plugin.StorageObject.exists

        def exists(self):
            if az_exists(self):
                return True
            self._is_dir = None
            return self.container_client().exists() and self.is_dir()

        az_plugin.StorageObject.exists = exists
    except (ImportError, AttributeError):
        pass

_recheck_storage_folders()

# Workflow type: basic, sctransform, integration, cell_cycle, full,
# sample_level, spatial
WORKFLOW = config.get("workflow", "basic")
WORKFLOWS = ["basic", "sctransform", "integration", "cell_cycle", "full",
             "sample_level", "spatial"]
if WORKFLOW not in WORKFLOWS:
    raise ValueError(f"Unknown workflow '{WORKFLOW}'. Choose one of: {', '.join(WORKFLOWS)}")

# Scripts: the scripts_dir setting; otherwise the copy in the image when
# Snakemake runs inside it (cloud executors; the image sets
# SEURAT_CLI_SCRIPTS) or rules run in it (--sdm apptainer, which only mounts
# the working directory); otherwise this checkout's.
SCRIPTS_DIR = (
    config.get("scripts_dir")
    or os.environ.get("SEURAT_CLI_SCRIPTS")
    or (config["container_scripts_dir"] if using_container()
        else os.path.normpath(os.path.join(workflow.basedir, "..", "..", "scripts"))))

# Relative to the working directory, or to --default-storage-prefix when
# outputs go to cloud storage
OUTPUT_DIR = config.get("output_dir", "results")

# Input files
INPUT_PATH = config.get("input_path", None)
INPUT_LIST = config.get("input_list", None)  # For integration

# Common parameters
SPECIES = config.get("species", "human")
THREADS = config.get("threads", 1)

# -----------------------------------------------------------------------------
# Resources
# -----------------------------------------------------------------------------

# Memory (MB) and time limit (minutes) for each rule, used by cluster and
# cloud executors. The defaults match the Nextflow pipeline. Under
# "resources" in the config, "default" overrides these for every rule, and a
# rule's own entry overrides that.
DEFAULT_RESOURCES = {
    "default": {"mem_mb": 8192, "runtime": 240},
    "sctransform": {"mem_mb": 6144, "runtime": 120},
    "integration": {"mem_mb": 16384, "runtime": 240},
    "differential_expression": {"mem_mb": 8192, "runtime": 120},
    "sample_level": {"mem_mb": 16384, "runtime": 240},
    "spatial": {"mem_mb": 16384, "runtime": 240},
}

# Memory sizes (MiB) the AWS Batch executor plugin accepts, and the vCPU
# counts allowed with each; it rejects or shrinks anything else.
AWS_BATCH_MEMORY = {
    2048: [1], 3072: [1], 4096: [1, 2], 5120: [1, 2], 6144: [1, 2],
    7168: [1, 2], 8192: [1, 2, 4], 9216: [2, 4], 10240: [2, 4],
    11264: [2, 4], 12288: [2, 4], 13312: [2, 4], 14336: [2, 4],
    15360: [2, 4], 16384: [2, 4, 8], 17408: [4], 18432: [4], 19456: [4],
    20480: [4, 8], 21504: [4], 22528: [4], 23552: [4], 24576: [4, 8],
    25600: [4], 26624: [4], 27648: [4], 28672: [4, 8], 29696: [4],
    30720: [4], 32768: [8, 16], 36864: [8], 40960: [8, 16], 45056: [8],
    49152: [8, 16], 53248: [8], 57344: [8, 16], 61440: [8], 65536: [16],
    73728: [16], 81920: [16], 90112: [16], 98304: [16], 106496: [16],
    114688: [16], 122880: [16],
}

def on_aws_batch():
    """True when jobs go to AWS Batch (known once the run starts, which is
    when Snakemake works out each job's threads and resources)."""
    plugin = getattr(workflow, "executor_plugin", None)
    return getattr(plugin, "name", None) == "aws-batch"

def aws_batch_fit(mem_mb, threads):
    """The (vCPUs, MiB) AWS Batch accepts that is closest above the request:
    the smallest memory size >= mem_mb, with the thread count raised to the
    next count that size allows."""
    sizes = sorted(m for m in AWS_BATCH_MEMORY if m >= mem_mb) or [max(AWS_BATCH_MEMORY)]
    counts = sorted({c for m in sizes for c in AWS_BATCH_MEMORY[m] if c >= threads}) or [16]
    for cpus in counts:
        for m in sizes:
            if cpus in AWS_BATCH_MEMORY[m]:
                return cpus, m
    return 16, max(AWS_BATCH_MEMORY)

def rule_config_resources(rule_name):
    """mem_mb and runtime for a rule: config overrides, then defaults."""
    user = config.get("resources") or {}
    res = dict(DEFAULT_RESOURCES["default"])
    res.update(DEFAULT_RESOURCES.get(rule_name, {}))
    res.update(user.get("default") or {})
    res.update(user.get(rule_name) or {})
    return res

def rule_threads(rule_name, threads):
    """The rule's threads, raised on AWS Batch if its memory needs more."""
    mem_mb = int(rule_config_resources(rule_name)["mem_mb"])
    return lambda wildcards: aws_batch_fit(mem_mb, threads)[0] if on_aws_batch() else threads

def rule_resources(rule_name):
    """Resources for a rule. On AWS Batch, memory is rounded up to a size it
    accepts. Google Batch reads its own CPU, memory and time limit settings,
    so those are set too."""
    res = rule_config_resources(rule_name)
    mem_mb = int(res["mem_mb"])
    res["mem_mb"] = lambda wildcards, threads: aws_batch_fit(mem_mb, threads)[1] if on_aws_batch() else mem_mb
    res.setdefault("googlebatch_memory", mem_mb)
    res.setdefault("googlebatch_max_run_duration", f"{int(res['runtime']) * 60}s")
    res.setdefault("googlebatch_cpu_milli", lambda wildcards, threads: threads * 1000)
    return res

# -----------------------------------------------------------------------------
# Helper Functions
# -----------------------------------------------------------------------------

# Each step's output folder, and the Seurat object it writes there
STEP_DIRS = {
    "basic": "01_basic",
    "sctransform": "01_sctransform",
    "integration": "01_integration",
    "cell_cycle": "02_cell_cycle",
    "differential_expression": "03_differential_expression",
    "visualization": "visualization",
    "sample_level": "sample_level",
    "spatial": "spatial",
}
STEP_RDS = {
    "basic": "seurat_object.rds",
    "sctransform": "seurat_sctransform.rds",
    "integration": "seurat_integrated.rds",
    "cell_cycle": "seurat_cell_cycle.rds",
}

def step_dir(step):
    return os.path.join(OUTPUT_DIR, STEP_DIRS[step])

def optional_arg(flag, value):
    """'--flag "value"', or nothing when the value is empty."""
    return f'{flag} "{value}"' if value else ""

def get_script_path(script_name):
    """Get full path to a script."""
    return os.path.join(SCRIPTS_DIR, script_name)

def data_input(path):
    """An input path. URLs (s3://, gs://, az://, https://, ...) are read with
    the matching Snakemake storage plugin; other paths are local, or relative
    to --default-storage-prefix when one is set."""
    if not path or path == "DEMO":
        return []
    path = str(path)
    return storage(path) if "://" in path else path

def integration_samples():
    """The samples for integration: a list in the config, a file with one
    path per line (blank and # lines skipped), or a comma-separated string.
    Nothing for the demo."""
    if not INPUT_LIST or INPUT_LIST == "DEMO":
        return []
    if isinstance(INPUT_LIST, (list, tuple)):
        lines = [str(l) for l in INPUT_LIST]
    elif os.path.isfile(INPUT_LIST):
        with open(INPUT_LIST) as f:
            lines = f.read().splitlines()
    elif "," in INPUT_LIST:
        lines = INPUT_LIST.split(",")
    else:
        raise ValueError(
            f"input_list file not found: {INPUT_LIST}. On cloud executors, jobs "
            "can't read a local list file: list the samples in the config "
            "instead (input_list: [sample1.rds, sample2.rds])")
    return [l.strip() for l in lines if l.strip() and not l.strip().startswith("#")]

def get_integration_input(wildcards):
    """Each sample, plus the list file when there is one, so Snakemake checks
    they exist before submitting jobs."""
    inputs = {"samples": [data_input(s) for s in integration_samples()]}
    if isinstance(INPUT_LIST, str) and os.path.isfile(INPUT_LIST):
        inputs["list_file"] = INPUT_LIST
    return inputs

def entry_step():
    """The step that loads the data for the workflow."""
    if WORKFLOW == "integration":
        return "integration"
    if WORKFLOW in ["sctransform", "full", "cell_cycle"]:
        return "sctransform"
    return "basic"

def analysis_step():
    """The step whose Seurat object DE and visualization use."""
    if WORKFLOW in ["full", "cell_cycle"]:
        return "cell_cycle"
    return entry_step()

def step_rds(step_folder, step):
    """The Seurat object inside a step's (local) output folder."""
    return os.path.join(step_folder, STEP_RDS[step])

def get_final_target():
    """Get the final target based on workflow."""
    if WORKFLOW == "sample_level":
        return step_dir("sample_level")
    if WORKFLOW == "spatial":
        return step_dir("spatial")
    return step_dir("visualization")

# -----------------------------------------------------------------------------
# Target Rules
# -----------------------------------------------------------------------------

rule all:
    input:
        get_final_target()

# Allow running up to specific steps
rule basic_analysis_only:
    input:
        step_dir("basic")

rule sctransform_only:
    input:
        step_dir("sctransform")

rule integration_only:
    input:
        step_dir("integration")

rule cell_cycle_only:
    input:
        step_dir("cell_cycle")

rule differential_expression_only:
    input:
        step_dir("differential_expression")

rule sample_level_only:
    input:
        step_dir("sample_level")

rule spatial_only:
    input:
        step_dir("spatial")

# -----------------------------------------------------------------------------
# Entry Point Rules (Choose One)
# -----------------------------------------------------------------------------

rule basic_analysis:
    """Run basic analysis (script 01) - entry point for 'basic' workflow."""
    input:
        data = data_input(INPUT_PATH)
    output:
        directory(step_dir("basic"))
    params:
        script = get_script_path("01_basic_analysis.R"),
        species = SPECIES,
        # --input with the data, nothing for the demo (--demo in extra_args)
        input_flag = "--input" if data_input(INPUT_PATH) else "",
        min_features = config.get("basic", {}).get("min_features", 200),
        max_features = config.get("basic", {}).get("max_features", 2500),
        max_mt = config.get("basic", {}).get("max_mt", 5),
        resolution = config.get("basic", {}).get("resolution", 0.5),
        dims = config.get("basic", {}).get("dims_use", "1:10"),
        extra = config.get("basic", {}).get("extra_args", "")
    threads: rule_threads("basic_analysis", THREADS)
    resources:
        **rule_resources("basic_analysis")
    log:
        os.path.join(OUTPUT_DIR, "logs", "basic_analysis.log")
    shell:
        """
        Rscript {params.script} \
            {params.input_flag} {input.data} \
            --output {output} \
            --species {params.species} \
            --min_features {params.min_features} \
            --max_features {params.max_features} \
            --max_mt {params.max_mt} \
            --resolution {params.resolution} \
            --dims_use "{params.dims}" \
            --threads {threads} \
            {params.extra} \
            2>&1 | tee {log}
        """

rule sctransform:
    """Run SCTransform analysis (script 02) - entry point for the 'sctransform', 'cell_cycle' and 'full' workflows."""
    input:
        data = data_input(INPUT_PATH)
    output:
        directory(step_dir("sctransform"))
    params:
        script = get_script_path("02_sctransform.R"),
        species = SPECIES,
        input_flag = "--input" if data_input(INPUT_PATH) else "",
        n_features = config.get("sctransform", {}).get("n_variable_features", 3000),
        resolution = config.get("sctransform", {}).get("resolution", 0.5),
        dims = config.get("sctransform", {}).get("dims_use", "1:30"),
        vars_to_regress = optional_arg("--vars_to_regress", config.get("sctransform", {}).get("vars_to_regress", "")),
        extra = config.get("sctransform", {}).get("extra_args", "")
    threads: rule_threads("sctransform", THREADS)
    resources:
        **rule_resources("sctransform")
    log:
        os.path.join(OUTPUT_DIR, "logs", "sctransform.log")
    shell:
        """
        Rscript {params.script} \
            {params.input_flag} {input.data} \
            --output {output} \
            --species {params.species} \
            --n_variable_features {params.n_features} \
            --resolution {params.resolution} \
            --dims_use "{params.dims}" \
            --threads {threads} \
            {params.vars_to_regress} \
            {params.extra} \
            2>&1 | tee {log}
        """

rule integration:
    """Run integration analysis (script 03) - entry point for 'integration' workflow."""
    input:
        unpack(get_integration_input)
    output:
        directory(step_dir("integration"))
    params:
        script = get_script_path("03_integration.R"),
        species = SPECIES,
        # The script reads a list of the samples where this job sees them
        # (local copies when they come from cloud storage), written below.
        # Nothing for the demo. A function, so the list is only read when
        # integration runs.
        list_arg = lambda wildcards: '--input_list "$list"' if integration_samples() else "",
        method = config.get("integration", {}).get("method", "CCAIntegration"),
        normalization = config.get("integration", {}).get("normalization", "LogNormalize"),
        resolution = config.get("integration", {}).get("resolution", 0.5),
        dims = config.get("integration", {}).get("dims_use", "1:30"),
        sample_names = optional_arg("--sample_names", config.get("integration", {}).get("sample_names", "")),
        conditions = optional_arg("--conditions", config.get("integration", {}).get("conditions", "")),
        extra = config.get("integration", {}).get("extra_args", "")
    threads: rule_threads("integration", THREADS)
    resources:
        **rule_resources("integration")
    log:
        os.path.join(OUTPUT_DIR, "logs", "integration.log")
    shell:
        """
        list=$(mktemp)
        trap 'rm -f "$list"' EXIT
        printf '%s\\n' {input.samples:q} > "$list"
        Rscript {params.script} \
            {params.list_arg} \
            --output {output} \
            --species {params.species} \
            --method {params.method} \
            --normalization {params.normalization} \
            --resolution {params.resolution} \
            --dims_use "{params.dims}" \
            --threads {threads} \
            {params.sample_names} \
            {params.conditions} \
            {params.extra} \
            2>&1 | tee {log}
        """

# -----------------------------------------------------------------------------
# Cell Cycle Rule
# -----------------------------------------------------------------------------

rule cell_cycle:
    """Run cell cycle scoring (script 05)."""
    input:
        step = step_dir(entry_step())
    output:
        directory(step_dir("cell_cycle"))
    params:
        script = get_script_path("05_cell_cycle.R"),
        species = SPECIES,
        rds = STEP_RDS[entry_step()],
        regress = "--regress_cc" if config.get("cell_cycle", {}).get("regress", False) else "",
        regress_diff = "--regress_cc_difference" if config.get("cell_cycle", {}).get("regress_difference", False) else "",
        extra = config.get("cell_cycle", {}).get("extra_args", "")
    threads: rule_threads("cell_cycle", 1)
    resources:
        **rule_resources("cell_cycle")
    log:
        os.path.join(OUTPUT_DIR, "logs", "cell_cycle.log")
    shell:
        """
        Rscript {params.script} \
            --input {input.step}/{params.rds} \
            --output {output} \
            --species {params.species} \
            {params.regress} \
            {params.regress_diff} \
            {params.extra} \
            2>&1 | tee {log}
        """

# -----------------------------------------------------------------------------
# Differential Expression Rule
# -----------------------------------------------------------------------------

rule differential_expression:
    """Run differential expression analysis (script 04)."""
    input:
        step = step_dir(analysis_step())
    output:
        directory(step_dir("differential_expression"))
    params:
        script = get_script_path("04_differential_expression.R"),
        rds = STEP_RDS[analysis_step()],
        mode = config.get("de", {}).get("mode", "all_markers"),
        test = config.get("de", {}).get("test_use", "wilcox"),
        logfc = config.get("de", {}).get("logfc_threshold", 0.25),
        min_pct = config.get("de", {}).get("min_pct", 0.1),
        extra = config.get("de", {}).get("extra_args", "")
    threads: rule_threads("differential_expression", THREADS)
    resources:
        **rule_resources("differential_expression")
    log:
        os.path.join(OUTPUT_DIR, "logs", "differential_expression.log")
    shell:
        """
        Rscript {params.script} \
            --input {input.step}/{params.rds} \
            --output {output} \
            --mode {params.mode} \
            --test_use {params.test} \
            --logfc_threshold {params.logfc} \
            --min_pct {params.min_pct} \
            --threads {threads} \
            {params.extra} \
            2>&1 | tee {log}
        """

# -----------------------------------------------------------------------------
# Visualization Rule
# -----------------------------------------------------------------------------

rule visualization:
    """Run visualization (script 06)."""
    input:
        step = step_dir(analysis_step()),
        de = step_dir("differential_expression")
    output:
        directory(step_dir("visualization"))
    params:
        script = get_script_path("06_visualization.R"),
        rds = STEP_RDS[analysis_step()],
        reduction = config.get("visualization", {}).get("reduction", "umap"),
        features = optional_arg("--features", config.get("visualization", {}).get("features", "")),
        extra = config.get("visualization", {}).get("extra_args", "")
    threads: rule_threads("visualization", 1)
    resources:
        **rule_resources("visualization")
    log:
        os.path.join(OUTPUT_DIR, "logs", "visualization.log")
    shell:
        """
        Rscript {params.script} \
            --input {input.step}/{params.rds} \
            --output {output} \
            --marker_file {input.de}/de_results_significant.csv \
            --reduction {params.reduction} \
            {params.features} \
            {params.extra} \
            2>&1 | tee {log}
        """

# -----------------------------------------------------------------------------
# Sample-Level Analysis Rule (scSLIDE, Seurat >= 6)
# -----------------------------------------------------------------------------

SAMPLE_LEVEL = config.get("sample_level", {})
SAMPLE_LEVEL_RDS = SAMPLE_LEVEL.get("input_rds", "")

def get_sample_level_input(wildcards):
    """An existing Seurat RDS (sample_level.input_rds), nothing for the demo,
    or the integration output folder."""
    if SAMPLE_LEVEL_RDS == "DEMO":
        return []
    if SAMPLE_LEVEL_RDS:
        return data_input(SAMPLE_LEVEL_RDS)
    return step_dir("integration")

rule sample_level:
    """Run sample-level analysis (script 07) - 'sample_level' workflow."""
    input:
        rds = get_sample_level_input
    output:
        directory(step_dir("sample_level"))
    params:
        script = get_script_path("07_sample_level.R"),
        # The integration output folder holds this object
        integrated_rds = STEP_RDS["integration"],
        # Defaults match the metadata written by 03_integration.R
        sample_col = SAMPLE_LEVEL.get("sample_col", "sample"),
        response = SAMPLE_LEVEL.get("response", "condition"),
        celltype_col = optional_arg("--celltype_col", SAMPLE_LEVEL.get("celltype_col", "seurat_clusters")),
        reduction = SAMPLE_LEVEL.get("reduction", "integrated"),
        dims = SAMPLE_LEVEL.get("dims", "1:30"),
        traj_dcs = SAMPLE_LEVEL.get("traj_dcs", "1"),
        latent_vars = optional_arg("--latent_vars", SAMPLE_LEVEL.get("latent_vars", "")),
        extra = SAMPLE_LEVEL.get("extra_args", "")
    threads: rule_threads("sample_level", THREADS)
    resources:
        **rule_resources("sample_level")
    log:
        os.path.join(OUTPUT_DIR, "logs", "sample_level.log")
    shell:
        """
        # The RDS, or the object in the integration output folder; no
        # --input for the demo
        rds={input.rds:q}
        if [ -d "$rds" ]; then rds="$rds/{params.integrated_rds}"; fi
        Rscript {params.script} \
            ${{rds:+--input "$rds"}} \
            --output {output} \
            --sample_col "{params.sample_col}" \
            --response "{params.response}" \
            {params.celltype_col} \
            --reduction {params.reduction} \
            --dims "{params.dims}" \
            --traj_dcs "{params.traj_dcs}" \
            {params.latent_vars} \
            --threads {threads} \
            {params.extra} \
            2>&1 | tee {log}
        """

# -----------------------------------------------------------------------------
# Spatial Rule (Xenium / Atera, Seurat >= 6)
