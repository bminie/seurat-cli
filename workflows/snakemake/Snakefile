SPATIAL = config.get("spatial", {})

rule spatial:
    """Run imaging spatial analysis (script 08) on input_path - 'spatial' workflow."""
    input:
        data = data_input(INPUT_PATH) if WORKFLOW == "spatial" else []
    output:
        directory(step_dir("spatial"))
    params:
        script = get_script_path("08_spatial.R"),
        platform = SPATIAL.get("platform", "auto"),
        molecules = optional_arg("--molecules", SPATIAL.get("molecules", "")),
        crop = optional_arg("--crop", SPATIAL.get("crop", "")),
        normalization = SPATIAL.get("normalization", "SCT"),
        resolution = SPATIAL.get("resolution", 0.3),
        extra = SPATIAL.get("extra_args", "")
    threads: rule_threads("spatial", THREADS)
    resources:
        **rule_resources("spatial")
    log:
        os.path.join(OUTPUT_DIR, "logs", "spatial.log")
    shell:
        """
        Rscript {params.script} \
            --input {input.data} \
            --output {output} \
            --platform {params.platform} \
            --normalization {params.normalization} \
            --resolution {params.resolution} \
            {params.molecules} \
            {params.crop} \
            --threads {threads} \
            {params.extra} \
            2>&1 | tee {log}
        """

# -----------------------------------------------------------------------------
# Utility Rules
# -----------------------------------------------------------------------------

rule clean:
    """Remove all output files."""
    log:
        os.path.join("logs", "clean.log")
    shell:
        f"rm -rfv {OUTPUT_DIR} > {{log}} 2>&1"

rule dag:
    """Generate DAG visualization."""
    output:
        "dag.png"
    log:
        os.path.join("logs", "dag.log")
    shell:
        "snakemake --dag 2> {log} | dot -Tpng > {output} 2>> {log}"
