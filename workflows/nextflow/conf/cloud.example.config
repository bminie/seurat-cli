/*
 * =============================================================================
 * Example cloud settings for the seurat-cli Nextflow pipeline
 * =============================================================================
 *
 * The awsbatch, googlebatch and azurebatch profiles in nextflow.config cover
 * a basic setup. Most accounts need a few more settings (networking, service
 * accounts, spot instances, an image in your own registry). Copy this file,
 * uncomment what you need, and pass it with -c:
 *
 *   nextflow run main.nf -profile awsbatch -c my-cloud.config ...
 *
 * Settings here override the profile's. Don't put account keys or secrets in
 * this file; use the environment variables or roles noted below.
 * Reference: https://docs.seqera.io/nextflow/reference/config
 * =============================================================================
 */

// -----------------------------------------------------------------------------
// Any cloud
// -----------------------------------------------------------------------------

// The image is ~6 GB and every new VM pulls it. A copy in your own registry
// (ECR, Artifact Registry, ACR) in the same region starts tasks faster and
// avoids public registry limits:
//   docker pull ghcr.io/bminie/seurat-cli:latest
//   docker tag ghcr.io/bminie/seurat-cli:latest <registry>/seurat-cli:latest
//   docker push <registry>/seurat-cli:latest
// params.container = '<registry>/seurat-cli:latest'

// Bigger tasks than the default 16 GB cap (raise per process below too)
// params.max_memory = 64.GB
// params.max_cpus = 16
// process {
//     withName: 'INTEGRATION' { memory = 64.GB; cpus = 8 }
// }

// -----------------------------------------------------------------------------
// AWS Batch (-profile awsbatch)
// -----------------------------------------------------------------------------
// Credentials: the launching machine uses the usual AWS chain (environment
// variables, ~/.aws, or an instance role). Tasks use the compute
// environment's instance role, which needs read/write access to the buckets.

// aws {
//     region = 'us-east-1'
//     batch {
//         // An IAM role for the task containers, if the instance role isn't
//         // the one with bucket access
//         jobRole = 'arn:aws:iam::123456789012:role/seurat-cli-batch-job'
//         // Retry tasks whose spot instance is reclaimed
//         maxSpotAttempts = 3
//         // Parallel S3 transfers per task
//         maxParallelTransfers = 4
//     }
// }
// process.queue = 'my-spot-queue'
// // A different queue for the big steps
// process {
//     withName: 'INTEGRATION|SAMPLE_LEVEL|SPATIAL' { queue = 'my-highmem-queue' }
// }

// -----------------------------------------------------------------------------
// Google Batch (-profile googlebatch)
// -----------------------------------------------------------------------------
// Credentials: Application Default Credentials on the launching machine.
// Tasks run as the job service account (by default the Compute Engine default
// account), which needs access to the buckets.

// google {
//     project = 'my-project-id'
//     location = 'us-central1'
//     batch {
//         serviceAccountEmail = 'seurat-cli@my-project-id.iam.gserviceaccount.com'
//         network = 'projects/my-project-id/global/networks/my-network'
//         subnetwork = 'projects/my-project-id/regions/us-central1/subnetworks/my-subnet'
//         // VMs without public IPs need Cloud NAT or a private registry copy
//         usePrivateAddress = true
//         // Room for the image and task files
//         bootDiskSize = 100.GB
//         spot = true
//         maxSpotAttempts = 3
//     }
// }
// // Pick machine types instead of letting Google Batch choose
// process {
//     withName: 'INTEGRATION|SAMPLE_LEVEL|SPATIAL' { machineType = 'n2-highmem-4' }
// }

// -----------------------------------------------------------------------------
// Azure Batch (-profile azurebatch)
// -----------------------------------------------------------------------------
// Credentials, one of:
//   - account keys: AZURE_BATCH_ACCOUNT_NAME, AZURE_BATCH_ACCOUNT_KEY,
//     AZURE_STORAGE_ACCOUNT_NAME, AZURE_STORAGE_ACCOUNT_KEY
//   - a service principal: AZURE_CLIENT_ID, AZURE_CLIENT_SECRET,
//     AZURE_TENANT_ID (plus the two account names)
//   - a managed identity: AZURE_MANAGED_IDENTITY_USER (client ID) or
//     AZURE_MANAGED_IDENTITY_SYSTEM=true (plus the two account names)

// azure {
//     batch {
//         location = 'eastus'
//         // Use pools you manage instead of automatic ones
//         // autoPoolMode = false
//         // pools {
//         //     seurat { vmType = 'Standard_E8d_v5'; autoScale = true; maxVmCount = 10 }
//         // }
//     }
//     // A private registry (e.g. ACR) for the image
//     // registry {
//     //     server = 'myregistry.azurecr.io'
//     //     userName = 'myregistry'
//     //     // Keep the password out of files you share or commit
//     //     password = '...'
//     // }
// }
// // Pools of a different VM family (glob), or one exact size
// process.machineType = 'Standard_D*d_v5'
// // With your own pools: process.queue = 'seurat'
